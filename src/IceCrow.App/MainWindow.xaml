<Window x:Class="IceCrow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IceCrow.Overlay.Controls;assembly=IceCrow.Overlay"
        Title="IceCrow — Developer"
        Width="1020"
        Height="600"
        MinWidth="720"
        MinHeight="360"
        Background="{StaticResource IceCrow.Brush.Surface}"
        ShowActivated="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:IcePanel Grid.RowSpan="3"
                           Grid.Column="0"
                           Header="Battlegrounds">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="BattlegroundsActive"
                               Margin="0,0,0,10"
                               Style="{StaticResource IceCrow.Text.Stat}"
                               Text="BG INACTIVE" />
                    <TextBlock x:Name="BattlegroundsTurn"
                               Margin="0,0,0,4"
                               Style="{StaticResource IceCrow.Text.Label}"
                               Text="Turn: 0" />
                    <TextBlock x:Name="BattlegroundsPhase"
                               Margin="0,0,0,4"
                               Style="{StaticResource IceCrow.Text.Label}"
                               Text="Phase: Unknown" />
                    <TextBlock x:Name="BattlegroundsPlayers"
                               Margin="0,0,0,4"
                               Style="{StaticResource IceCrow.Text.Label}"
                               Text="Players: 0" />
                    <TextBlock x:Name="BattlegroundsOpponent"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Label}"
                               Text="Opponent: PlayerId -" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Live pipeline" />
                    <TextBlock x:Name="LiveRawLines"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Raw / parsed: 0 / 0" />
                    <TextBlock x:Name="LiveRejectedLines"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Ignored / unknown / malformed: 0 / 0 / 0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LiveAppliedEvents"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Applied: 0" />
                    <TextBlock x:Name="LiveTrackingState"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Tracking: Inactive" />
                    <TextBlock x:Name="LiveLastUpdate"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Last update: -" />
                    <TextBlock x:Name="TailerResets"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Full rereads: 0" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Overlay rendering" />
                    <TextBlock x:Name="OverlayRenderStats"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="No overlay updates yet"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Manacost data" />
                    <TextBlock x:Name="ManacostCache"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Cache: Not available" />
                    <TextBlock x:Name="ManacostVersion"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Data version: -" />
                    <TextBlock x:Name="ManacostBuild"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Hearthstone build: -" />
                    <TextBlock x:Name="ManacostSync"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Last sync: -" />
                    <TextBlock x:Name="ManacostCounts"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Cards / BG minions / heroes: 0 / 0 / 0"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Deckstrings" />
                    <TextBlock x:Name="DeckstringsStatus"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Package: - · Status: -" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Telemetry" />
                    <TextBlock x:Name="TelemetryStatus"
                               Margin="0,0,0,16"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Consent: Off · Queued: 0 · Last upload: -"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,6"
                               Style="{StaticResource IceCrow.Text.SectionTitle}"
                               Text="Match capture" />
                    <CheckBox x:Name="CaptureToggle"
                              Margin="0,0,0,6"
                              Checked="OnCaptureToggleChanged"
                              Content="Record matches (private)"
                              Foreground="{StaticResource IceCrow.Brush.TextSecondary}"
                              Unchecked="OnCaptureToggleChanged" />
                    <TextBlock x:Name="CaptureStatus"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Enabled: No · Session: Off · Persistence: Idle"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureDetail"
                               Margin="0,0,0,3"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="Captures: 0 · Last: -"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureMessages"
                               Style="{StaticResource IceCrow.Text.Caption}"
                               Text="-"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </controls:IcePanel>

        <DockPanel Grid.Column="2" Margin="0,0,0,4">
            <Button x:Name="DesignPreviewButton"
                    VerticalAlignment="Bottom"
                    Click="OnOpenDesignPreviewClicked"
                    Content="Design preview"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IceCrow.Style.Button}" />
            <TextBlock Style="{StaticResource IceCrow.Text.HeroTitle}" Text="Power Log" />
            <TextBlock Margin="12,0,0,2"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource IceCrow.Text.Caption}"
                       Text="Developer view · latest 20 accepted lines" />
        </DockPanel>

        <TextBlock x:Name="PowerLogStatus"
                   Grid.Row="1"
                   Grid.Column="2"
                   Margin="0,8,0,8"
                   Style="{StaticResource IceCrow.Text.Label}"
                   Text="Waiting for Hearthstone Power.log…" />

        <controls:IcePanel Grid.Row="2" Grid.Column="2">
            <ListBox x:Name="PowerLogList"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     Foreground="{StaticResource IceCrow.Brush.TextSecondary}"
                     HorizontalContentAlignment="Stretch"
                     IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </controls:IcePanel>
    </Grid>
</Window>
