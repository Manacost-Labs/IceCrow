<Window x:Class="IceCrow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IceCrow — Developer"
        Width="980"
        Height="540"
        MinWidth="720"
        MinHeight="360"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Background="#10151C">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#F4F7FA"
                       Text="Power Log" />
            <TextBlock Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="#6F7C89"
                       Text="Developer view · latest 20 accepted lines" />
        </DockPanel>

        <TextBlock x:Name="PowerLogStatus"
                   Grid.Row="1"
                   Margin="0,12,0,12"
                   Foreground="#9BA7B4"
                   Text="Waiting for Hearthstone Power.log…" />

        <Border Grid.Row="2"
                Padding="12"
                Background="#0A0E13"
                BorderBrush="#26313D"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox x:Name="PowerLogList"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     Foreground="#D8E0E8"
                     HorizontalContentAlignment="Stretch"
                     IsHitTestVisible="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
