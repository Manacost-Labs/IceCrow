<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IceCrow.Overlay\IceCrow.Overlay.csproj" />
    <ProjectReference Include="..\IceCrow.Platform.Windows\IceCrow.Platform.Windows.csproj" />
    <ProjectReference Include="..\IceCrow.Presentation\IceCrow.Presentation.csproj" />
    <ProjectReference Include="..\IceCrow.Hearthstone.Data\IceCrow.Hearthstone.Data.csproj" />
    <ProjectReference Include="..\IceCrow.Hearthstone.Decks\IceCrow.Hearthstone.Decks.csproj" />
    <ProjectReference Include="..\IceCrow.Infrastructure.ManacostApi\IceCrow.Infrastructure.ManacostApi.csproj" />
    <ProjectReference Include="..\IceCrow.Telemetry\IceCrow.Telemetry.csproj" />
    <ProjectReference Include="..\IceCrow.Hearthstone.Logs\IceCrow.Hearthstone.Logs.csproj" />
    <ProjectReference Include="..\IceCrow.Live\IceCrow.Live.csproj" />
    <ProjectReference Include="..\IceCrow.Recording\IceCrow.Recording.csproj" />
  </ItemGroup>

  <!--
    The developer design preview is a Debug-only surface and must not ship.
    Removing both the page and its code-behind keeps the Release binary free of
    preview XAML, sample data, and the generated partial class.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="DesignPreview\**" />
    <Compile Remove="DesignPreview\**" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
