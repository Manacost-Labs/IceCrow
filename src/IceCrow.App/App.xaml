<Application x:Class="IceCrow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No application-level resources on purpose. The IceCrow design system is
        merged by the overlay library itself (OverlayWindow and Generic.xaml),
        so the headless Release composition never loads the overlay assembly
        just to satisfy an application resource dictionary.
    -->
</Application>
