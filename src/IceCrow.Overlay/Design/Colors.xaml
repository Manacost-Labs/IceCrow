<!--
    IceCrow colour primitives.

    This is the ONLY file in the UI that is allowed to contain literal colour
    values. Everything else consumes the semantic brushes in Brushes.xaml.
    Direction: cold graphite base, blue-grey secondaries, one pale ice accent
    that should occupy well under ~10% of the visible overlay.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces. Never pure black: #0B0F14 keeps text edges soft on OLED and IPS.  -->
    <Color x:Key="IceCrow.Color.Surface">#FF0B0F14</Color>
    <Color x:Key="IceCrow.Color.SurfaceRaised">#FF131A22</Color>
    <Color x:Key="IceCrow.Color.SurfaceHover">#FF1B242F</Color>
    <Color x:Key="IceCrow.Color.SurfaceSelected">#FF212C39</Color>

    <!--
        Floating overlay panels. 95–98% opacity instead of transparency plus blur:
        readable over bright Hearthstone scenes and free of continuous composition.
    -->
    <Color x:Key="IceCrow.Color.PanelSurface">#F2131A22</Color>
    <Color x:Key="IceCrow.Color.PanelSurfaceStrong">#FA0E141B</Color>

    <!--  Separation.  -->
    <Color x:Key="IceCrow.Color.Border">#FF243039</Color>
    <Color x:Key="IceCrow.Color.BorderStrong">#FF35454F</Color>

    <!--  Text. Near-white with a cold cast, never pure #FFFFFF on large runs.  -->
    <Color x:Key="IceCrow.Color.TextPrimary">#FFE8EEF4</Color>
    <Color x:Key="IceCrow.Color.TextSecondary">#FFA7B7C6</Color>
    <Color x:Key="IceCrow.Color.TextMuted">#FF6F8090</Color>

    <!--  Accent: pale ice blue. Used for the signature notch and single markers.  -->
    <Color x:Key="IceCrow.Color.Accent">#FF7FD8E8</Color>
    <Color x:Key="IceCrow.Color.AccentStrong">#FFA8ECF7</Color>
    <Color x:Key="IceCrow.Color.AccentSoft">#3D7FD8E8</Color>

    <!--  Status. Each is always paired with text, never used as the only signal.  -->
    <Color x:Key="IceCrow.Color.Positive">#FF7FC79A</Color>
    <Color x:Key="IceCrow.Color.Warning">#FFE0B36A</Color>
    <Color x:Key="IceCrow.Color.Danger">#FFD9737A</Color>
    <Color x:Key="IceCrow.Color.WarningSoft">#33E0B36A</Color>
    <Color x:Key="IceCrow.Color.DangerSoft">#33D9737A</Color>
    <Color x:Key="IceCrow.Color.PositiveSoft">#337FC79A</Color>

    <!--  Shadow tint for the single allowed drop shadow.  -->
    <Color x:Key="IceCrow.Color.Shadow">#FF05080B</Color>

</ResourceDictionary>
